{
  "name": "scalecloud",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "test:ui": "ng test --ui",
    "test:coverage": "ng test --coverage --watch=false",
    "lint": "ng lint",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org scalecloudde --project scalecloud ./dist/scalecloud/browser && sentry-cli sourcemaps upload --org scalecloudde --project scalecloud --strict --wait ./dist/scalecloud/browser"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@sentry/angular": "^11.10.0",
    "@stripe/stripe-js": "^10.2.0",
    "angular-auth-oidc-client": "^22.0.2",
    "cobe": "^2.0.1",
    "firebase": "^13.1.0",
    "ngx-skeleton-loader": "^14.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.5",
    "@angular-devkit/schematics": "^22.2.5",
    "@angular-eslint/builder": "^22.6.0",
    "@angular/animations": "^22.2.4",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@eslint/js": "^10.0.1",
    "@schematics/angular": "^22.2.5",
    "@sentry/cli": "^3.8.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true,
    "lmdb@3.5.6": true,
